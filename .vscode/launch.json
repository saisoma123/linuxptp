{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run ptp4l (with gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/ptp4l",
      "args": [
        "-m",
        "-l",
        "7",
        "-i",
        "eth0"
      ],
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "stopAtEntry": false,
    }
  ]
}